{
  "name": "@carelink/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "eas-build-post-install": "cd ../.. && npm run build --workspace @carelink/shared",
    "android": "expo run:android --no-build-cache --device",
    "prebuild": "expo prebuild -p android",
    "ios": "expo run:ios",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "echo \"no mobile tests yet\" && exit 0"
  },
  "dependencies": {
    "@carelink/shared": "*",
    "@carelink/theme": "*",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "axios": "^1.7.7",
    "date-fns": "^4.4.0",
    "expo": "~57.0.21",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "react": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-paper-dates": "^0.23.16",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "typescript"
      ]
    }
  }
}
