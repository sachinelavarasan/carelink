# ============================================================
# Minimum to boot the API (M0/M1)
# ============================================================

# Supabase → Project Settings → Database.
# The API runtime (postgres-js) connects via DATABASE_URL; migrations and the
# seed use the discrete DB_* credentials below. If DATABASE_URL is left unset,
# it is assembled from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (see
# src/config.ts), so the discrete vars alone are enough to boot.
#
# Pooled connection (pgBouncer, port 6543) — best for the runtime:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DB_POOL_MAX=1

# Discrete credentials — used by `migration:run` / drizzle-kit / `seed:run`, and
# as the fallback source for DATABASE_URL. Use the direct (port 5432) connection.
# SSL is enabled when NODE_ENV=production.
DB_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER="postgres.<ref>"
DB_PASSWORD="<password>"

# Auth secrets — any random string 24+ chars, different from each other.
JWT_ACCESS_SECRET="change-me-to-a-random-32-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-32-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

APP_WEB_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# Web auth cookies (mobile uses Bearer tokens, unaffected).
# Local dev defaults are fine. In production set COOKIE_SECURE=true and keep
# COOKIE_SAMESITE=lax: the browser must only ever talk to the web origin (via a
# dev proxy locally, or the Vercel /api rewrite in prod). COOKIE_SAMESITE=none
# means third-party cookies, which browsers now block by default — the session
# then drops on the next page load.
COOKIE_SECURE=""
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# ============================================================
# Optional — leave blank until you need them
# ============================================================

# Email (Nodemailer SMTP). If blank, the API logs verification/reset links to the
# console instead of sending. Free options: Brevo (300/day), Gmail app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CareLink <no-reply@yourdomain.com>"

# File storage (Cloudinary) — prescription PDFs (M4), later chat attachments +
# medical documents. If blank, prescriptions still finalise and the PDF is
# rendered on demand by GET /prescriptions/:id/pdf (just not persisted).
# Dashboard → Account Details → "API environment variable".
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="carelink"
FILE_URL_TTL_SECONDS="300"

# Cron job runner shared secret (M2).
CRON_SECRET=""

# Video consultation (Jitsi). Default meet.jit.si; set a self-hosted domain later.
JITSI_DOMAIN="meet.jit.si"

# Error tracking (Sentry) — optional. Blank = disabled.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"

# ============================================================
# Doctor seed (npm run db:seed --workspace @carelink/api)
# ============================================================
DOCTOR_EMAIL=""
DOCTOR_PASSWORD=""
DOCTOR_NAME="Dr. Example"
DOCTOR_COUNCIL="Tamil Nadu Medical Council"
DOCTOR_REG_NO="TNMC-00000"
DOCTOR_QUALIFICATIONS="MBBS, MD"
DOCTOR_SPECIALIZATIONS="General Medicine"
DOCTOR_YEARS="10"
DOCTOR_FEE_INR="300"
